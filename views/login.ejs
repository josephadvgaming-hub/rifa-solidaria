<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ingresar · Rifa Solidaria</title><link rel="stylesheet" href="/style.css"></head><body><main class="login panel"><h1>🐾 Rifa solidaria</h1><p>Ingreso de vendedores y administrador</p><% if(message){ %><p class="alert"><%= message %></p><% } %><form method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Usuario<input name="username" required autocomplete="username"></label><label>Contraseña<input name="password" type="password" required autocomplete="current-password"></label><button>Ingresar</button></form></main></body></html>
