<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rifa <%= letter %></title><link rel="stylesheet" href="/style.css"></head><body><header><a href="/">← Panel</a><b>Rifa <%= letter %></b><span><%= user.username %></span></header><main><h1>Rifa <%= letter %> · números 01–100</h1><p>Verde: disponible · Amarillo: reservado · Rojo: pagado · Azul: seleccionado</p><% if(message){ %><p class="alert"><%= message %></p><% } %><div class="ticket-grid" id="grid"><% tickets.forEach(t=>{ %><button type="button" data-number="<%= t.number %>" class="ticket <%= t.status %>" <%= t.status!=='available'?'disabled':'' %>><%= String(t.number).padStart(2,'0') %></button><% }) %></div><section class="panel"><h2>Reservar números</h2><form method="post" action="/tickets/reserve" id="reserve"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="letter" value="<%= letter %>"><input type="hidden" name="numbers" id="numbers"><p id="selected">Seleccionados: ninguno</p><label>Nombre del comprador<input name="buyer_name" maxlength="120" required minlength="2"></label><label>Teléfono<input name="buyer_phone" maxlength="40" required minlength="5" placeholder="+56 9 ..."></label><button>Guardar reserva</button></form></section><section class="panel"><h2>Números reservados y pagados</h2><div class="tablewrap"><table><thead><tr><th>N°</th><th>Estado</th><th>Comprador</th><th>Teléfono</th><th>Vendedor</th><th>Acciones</th></tr></thead><tbody><% tickets.filter(t=>t.status!=='available').forEach(t=>{ %><tr><td><b><%= letter %>-<%= String(t.number).padStart(2,'0') %></b></td><td><%= t.status==='paid'?'Pagado':'Reservado' %></td><td><%= t.buyer_name %></td><td><%= t.buyer_phone %></td><td><%= t.seller %></td><td><% if(t.status==='reserved'&&(user.role==='admin'||Number(user.id)===Number(t.seller_id))){ %><form class="inline" method="post" action="/tickets/<%= letter %>/<%= t.number %>/pay"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small">Confirmar pago</button></form><form class="inline" method="post" action="/tickets/<%= letter %>/<%= t.number %>/release" onsubmit="return confirm('¿Liberar este número?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small secondary">Liberar</button></form><% } %></td></tr><% }) %></tbody></table></div></section></main><script src="/app.js"></script></body></html>
